# Copy to .env (gitignored). Never commit real values.
AIRTABLE_TOKEN=            # Airtable personal access token: scopes data.records:read/write, schema.bases:read
AIRTABLE_BASE_ID=          # app... (see README)
AIRTABLE_TABLE=Games
RAWG_API_KEY=              # free key from https://rawg.io/apidocs (used by the Lambda via SSM; local only for ad-hoc runs)
LAMBDA_FUNCTION_NAME=game-tracker-cover-art
# Needed only for scripts that touch AWS locally:
# AWS_PROFILE=
# AWS_REGION=
