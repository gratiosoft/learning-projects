# Copy to .env (gitignored). Never commit real values. No inline comments after values.

# Airtable personal access token; scopes: data.records:read, data.records:write, schema.bases:read, schema.bases:write
AIRTABLE_TOKEN=
# Base ID (app...) of the "Game Collection Tracker" base
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Games
# Free key from https://rawg.io/apidocs (the Lambda reads it from SSM; .env is for local runs)
RAWG_API_KEY=
LAMBDA_FUNCTION_NAME=game-tracker-cover-art
